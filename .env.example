DATABASE_URL=postgresql://username:password@localhost:5432/hospital_management
FLASK_SECRET_KEY=generate-a-unique-secret-for-this-environment
FLASK_DEBUG=false

# Optional. Leave blank to keep the chatbot disabled.
GROQ_API_KEY=

# Demo seeding is disabled unless explicitly enabled for a local/test database.
HMS_ALLOW_DEMO_USERS=false
HMS_DEMO_PASSWORD_ADMIN=
HMS_DEMO_PASSWORD_DOCTOR=
HMS_DEMO_PASSWORD_RECEPTIONIST=
HMS_DEMO_PASSWORD_PHARMACIST=
HMS_DEMO_PASSWORD_LABTECH=
HMS_DEMO_PASSWORD_ACCOUNTANT=
HMS_DEMO_PASSWORD_HR_MANAGER=
HMS_DEMO_PASSWORD_PROCUREMENT=
HMS_DEMO_PASSWORD_BRANCH_MANAGER=
